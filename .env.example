# SUPABASE
VITE_SUPABASE_URL=COLOCAR_URL_DO_SUPABASE_AQUI
VITE_SUPABASE_ANON_KEY=COLOCAR_CHAVE_ANON_DO_SUPABASE_AQUI

# STRIPE (frontend — public key only)
VITE_STRIPE_PUBLIC_KEY=pk_test_…

# STRIPE (Edge Functions secrets — set in Supabase Dashboard → Settings → Edge Functions)
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…

# APP
VITE_APP_NAME=CareConnect
VITE_APP_ENV=development
# APP_URL — set in Supabase Edge Function secrets so Connect redirects point to the right host
# APP_URL=https://yourapp.vercel.app
